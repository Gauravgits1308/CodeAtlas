datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RepositoryStatus {
  PENDING
  QUEUED
  CLONING
  ANALYZING
  INDEXING
  PROCESSING
  COMPLETED
  PARTIALLY_INDEXED
  FAILED
  CANCELLED
  STALLED
}

model User {
  id           String       @id // Clerk User ID
  email        String       @unique
  name         String?
  repositories Repository[]
  conversations Conversation[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Repository {
  id               String                      @id @default(uuid())
  githubRepoId     String
  name             String
  fullName         String
  owner            String
  visibility       String
  defaultBranch    String                      @default("main")
  cloneUrl         String
  htmlUrl          String
  description      String?
  primaryLanguage  String?
  stars            Int                         @default(0)
  forks            Int                         @default(0)
  watchers         Int                         @default(0)
  status           RepositoryStatus            @default(PENDING)
  lastSyncedAt     DateTime?
  userId           String
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics          CodeMetric?
  syncLogs         SyncLog[]
  chunks           CodeChunk[]
  conversations    Conversation[]
  processingStatus RepositoryProcessingStatus?
  isArchived       Boolean                     @default(false)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  chunksCount      Int                         @default(0)
  embeddingsCount  Int                         @default(0)

  @@unique([owner, name, userId])
}

model CodeMetric {
  id                    String     @id @default(uuid())
  repositoryId          String     @unique
  repository            Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  linesCount            Int        @default(0)
  filesCount            Int        @default(0)
  languages             Json       // e.g. [{ "name": "TypeScript", "percentage": 68.5 }]
  complexityScore       Int?
  dependencyCount       Int        @default(0)
  largestFiles          Json       // e.g. [{ "path": "src/core.ts", "lines": 1200 }]
  largestDirectories    Json       // e.g. [{ "path": "src/controllers", "filesCount": 24 }]
  averageFileSize       Float      @default(0.0)
  documentationCoverage Float      @default(0.0)
  updatedAt             DateTime   @updatedAt
}

model SyncLog {
  id           String     @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  status       String     // "success" | "failed"
  errorMessage String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
}

model CodeChunk {
  id             String          @id @default(uuid())
  repositoryId   String
  repository     Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  filePath       String
  startLine      Int
  endLine        Int
  content        String
  classification String?

  embedding      ChunkEmbedding?

  createdAt      DateTime        @default(now())

  @@index([repositoryId])
}

model ChunkEmbedding {
  id         String    @id @default(uuid())

  chunkId    String    @unique
  chunk      CodeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  provider   String
  model      String
  dimensions Int
  embedding  Unsupported("vector")?

  createdAt  DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id           String      @id @default(uuid())
  repositoryId String
  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  messages     Message[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([repositoryId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant"
  content        String
  sources        Json?        // To store source citations
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model RepositoryProcessingStatus {
  id                   String     @id @default(uuid())
  repositoryId         String     @unique
  repository           Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  currentStage         String     @default("QUEUED")
  stageProgress        Float      @default(0.0)
  startedAt            DateTime?  @default(now())
  finishedAt           DateTime?
  lastUpdated          DateTime   @updatedAt
  currentMessage       String?
  errorMessage         String?
  estimatedRemainingTime String?
  processedFiles       Int        @default(0)
  totalFiles           Int        @default(0)
  processedChunks      Int        @default(0)
  totalChunks          Int        @default(0)
  embeddingsGenerated  Int        @default(0)
  duration             Int        @default(0)
  lastHeartbeat        DateTime   @default(now())
  completedStages      Json?      // E.g. ["CLONING", "EXTRACTING"]
  failedStage          String?
  logs                 Json?      // To store the logs array: [{ timestamp: string, message: string, stage: string }]
}
